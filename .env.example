# Root-level reference for the whole stack. Each app also has its own .env.example
# (apps/api/.env.example, apps/*/.env.example) with the variables that app actually reads.

APP_ENV=development
APP_NAME=telegram-marketplace-api

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketplace

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

COOKIE_SAMESITE=lax
COOKIE_SECURE=false
CSRF_SECRET=
